{
  "theme": "default",
  "auto_fit_columns": true,
  "keybindings": {
    "quit": ["q", "ctrl+c"],
    "help": ["?"],
    "toggle_theme": ["T"],
    "toggle_sidebar": ["s", "S"],
    "clear_filter": ["C"],
    "focus_next": ["tab"],
    "up": ["k", "up"],
    "down": ["j", "down"],
    "left": ["h", "left"],
    "right": ["l", "right"],
    "page_up": ["pgup"],
    "page_down": ["pgdown"],
    "home": ["home"],
    "end": ["end"],
    "jump_first_column": ["H"],
    "jump_last_column": ["L"],
    "next_page": [">"],
    "prev_page": ["<"],
    "goto_definition": ["gd"],
    "view_structure": ["d"],
    "yank": ["y"],
    "preview": ["p"],
    "filter": ["/", "f"],
    "new_connection": ["n"],
